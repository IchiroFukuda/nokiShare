# ローカル開発環境用設定
NODE_ENV=development
NEXT_PUBLIC_ENV=local

# Supabase設定（ローカル開発用）
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# データベース設定（ローカル開発用）
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# アプリケーション設定
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ログ設定
LOG_LEVEL=debug
ENABLE_DEBUG_LOGS=true

# セキュリティ設定（開発用）
JWT_SECRET=your-local-jwt-secret-key-here
ENCRYPTION_KEY=your-local-encryption-key-here

# 外部API設定（開発用）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-key-here
STRIPE_SECRET_KEY=sk_test_your-test-secret-key-here

# メール設定（開発用）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=test-password

# ファイルアップロード設定（開発用）
NEXT_PUBLIC_UPLOAD_URL=http://localhost:3000/api/upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 監査ログ設定（開発用）
ENABLE_AUDIT_LOGS=true
AUDIT_LOG_RETENTION_DAYS=30 
